# =============================================================================
# LINKFLOW environment template
# Copy to .env.local for local development, and add the same values (minus the
# development-only flags) to your hosting provider.
#
# NEVER commit .env.local or real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Project Settings → API in the Supabase dashboard.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public client key. Paste EITHER the newer publishable key
# (sb_publishable_…) into NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, or the legacy
# anon JWT into NEXT_PUBLIC_SUPABASE_ANON_KEY. Both are public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. Bypasses Row Level Security. Never expose to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public origin of this deployment, used in OAuth redirects and email links.
# LinkedIn only accepts HTTPS redirect URLs, even for local development. To test
# OAuth locally, run an HTTPS tunnel (for example
# `cloudflared tunnel --url http://localhost:3000`) and set this to the tunnel
# origin. Plain http://localhost is fine for email links and the app itself, but
# LinkedIn will reject it at the consent screen.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social sign-in buttons rendered on /login and /signup. Comma-separated:
# google, github, linkedin_oidc. Use `none` (or leave empty) to hide them.
# Enable each provider in Supabase → Authentication → Providers first.
NEXT_PUBLIC_AUTH_PROVIDERS=google

# -----------------------------------------------------------------------------
# LinkedIn OAuth app (required for real publishing)
# Create at https://www.linkedin.com/developers/apps
# Redirect URL must be exactly: ${NEXT_PUBLIC_APP_URL}/api/linkedin/callback
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=<linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<linkedin-client-secret>

# Space-separated. The default below is the self-serve set: personal publishing
# works without Community Management API review.
#
# Supported fallback: if w_organization_social / r_organization_admin are listed
# before LinkedIn approves the app, LinkedIn rejects the authorization with
# invalid_scope. LINKFLOW then retries once with personal scopes only, so sign-in
# and personal posting keep working. Add the org scopes now with no risk, and
# click Reconnect on /accounts after approval to pick up page publishing.
LINKEDIN_SCOPES=openid profile email w_member_social
# Company pages (safe to enable before approval because of the fallback):
# LINKEDIN_SCOPES=openid profile email w_member_social w_organization_social r_organization_admin

# LinkedIn marketing API version header (YYYYMM). 202610 is the newest supported
# version as of October 2026. Update as LinkedIn retires older versions.
LINKEDIN_API_VERSION=202610

# Optional override. Defaults to ${NEXT_PUBLIC_APP_URL}/api/linkedin/callback.
# Must be HTTPS for LinkedIn. Use an HTTPS tunnel for local OAuth, e.g.
# `cloudflared tunnel --url http://localhost:3000`, then set:
# LINKEDIN_REDIRECT_URI=https://<tunnel-host>/api/linkedin/callback
# Keep NEXT_PUBLIC_APP_URL on http://localhost:3000 so Supabase email links work.
# The path must be exactly /api/linkedin/callback and must be registered in the
# LinkedIn app's Auth → Redirect URLs list.

# -----------------------------------------------------------------------------
# Facebook Pages (optional — only needed if you connect Facebook)
# Create at https://developers.facebook.com/apps
# Add the "Facebook Login" product and set the Valid OAuth Redirect URI to:
#   ${NEXT_PUBLIC_APP_URL}/api/facebook/callback
# Meta only allows API posting to Pages (not personal profiles).
# pages_manage_posts requires App Review + business verification in live mode.
# -----------------------------------------------------------------------------
# FACEBOOK_APP_ID=<facebook-app-id>
# FACEBOOK_APP_SECRET=<facebook-app-secret>

# Comma- or space-separated. public_profile is granted by default.
# FACEBOOK_SCOPES=public_profile pages_show_list pages_read_engagement pages_manage_posts

# Graph API version used for OAuth and publishing (default v23.0).
# FACEBOOK_GRAPH_VERSION=v23.0

# Optional override. Defaults to ${NEXT_PUBLIC_APP_URL}/api/facebook/callback.
# Must be registered exactly in Meta → Facebook Login → Settings →
# Valid OAuth Redirect URIs.
# FACEBOOK_REDIRECT_URI=https://<your-domain>/api/facebook/callback

# Only for apps created with "Facebook Login for Business" (Meta's new default).
# Copy the Configuration ID from Meta → Facebook Login for Business →
# Configurations. When set, the OAuth dialog uses config_id instead of scopes.
# FACEBOOK_LOGIN_CONFIG_ID=<business-login-config-id>

# -----------------------------------------------------------------------------
# Publishing engine cron (required for automatic publishing)
# Shared secret between pg_cron/pg_net and the Edge Function. Generate a long
# random value, e.g. `openssl rand -hex 32`.
# -----------------------------------------------------------------------------
CRON_SECRET=<long-random-string>

# Optional, local-only convenience for `npm run db:push:api`, which applies the
# migrations through the Supabase Management API instead of the SQL editor.
# Create one at https://supabase.com/dashboard/account/tokens and delete it once
# the migrations are applied. This is a build-time helper, not app runtime config.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Optional. Defaults to ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1.
# Set only if you proxy Edge Functions through a custom domain.
# SUPABASE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1

# -----------------------------------------------------------------------------
# Development-only switches
# Both are hard-disabled when NODE_ENV=production. Never enable either on a
# production deployment.
# -----------------------------------------------------------------------------

# Serves read-only fixtures so the UI is viewable without Supabase.
LINKFLOW_DEMO_MODE=0

# Simulates LinkedIn publishing. Results are stored with is_mock = true and
# labelled in the UI. The Edge Function refuses to run if LINKFLOW_ENV is
# production.
LINKEDIN_MOCK_MODE=false

# Simulates Facebook publishing the same way. Connect mock Facebook from
# /accounts after enabling (no Meta app needed).
FACEBOOK_MOCK_MODE=false

# Set to `production` on the Edge Function to hard-block mock publishing.
# LINKFLOW_ENV=production
